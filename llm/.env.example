# Подключение к PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=trader
POSTGRES_PASSWORD=strongpassword
POSTGRES_DB=crypto_news
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Вариант 1: Локальная Ollama (по умолчанию, Mac / Linux)
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=deepseek-r1:14b

# Вариант 2: Облачный DeepSeek API (api.deepseek.com)
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# Вариант 3: OpenAI API
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Параметры инференса LLM
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=16384
LLM_TIMEOUT=120.0
LLM_MAX_RETRIES=3

# Параметры воркера
BATCH_SIZE=3
POLL_INTERVAL_SECONDS=10
ERROR_RETRY_DELAY_SECONDS=5
MAX_CONCURRENT_REQUESTS=2
MAX_CONTENT_CHARS=6000
LOG_LEVEL=INFO
