# Подключение к PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=trader
POSTGRES_PASSWORD=strongpassword
POSTGRES_DB=crypto_news
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# Binance API
BINANCE_BASE_URL=https://api.binance.com
HTTP_TIMEOUT_SECONDS=15.0

# Параметры Event Study
PRE_WINDOW_HOURS=4
POST_WINDOW_HOURS=24
CANDLE_INTERVAL=15m
NEUTRAL_THRESHOLD_PCT=0.2
MIN_NEWS_AGE_HOURS=4.0

# Параметры воркера
BATCH_SIZE=5
POLL_INTERVAL_SECONDS=30
LOG_LEVEL=INFO
