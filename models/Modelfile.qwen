FROM qwen3.8:27b

# Ограничиваем контекст до 8k токенов для исключения свопа на 24GB Apple Silicon
PARAMETER num_ctx 8192

# Снижаем температуру: убирает блуждания мыслей и фиксирует строгий JSON
PARAMETER temperature 0.2
PARAMETER top_p 0.85
PARAMETER top_k 20

# Ограничение максимальной длины генерации
PARAMETER num_predict 2048

# Системная инструкция для сжатого (Low) рассуждения
SYSTEM """You are a quantitative financial sentiment analyst.
Keep your internal reasoning process (<think>...</think>) concise, brief, and strictly focused on:
1. Core directional catalyst (supply/demand impact).
2. Transmission channel and asset tickers.
3. Verification whether the news is a hard fact or speculative noise.
Limit internal thinking to 2-4 sentences max. Do not overthink. Immediately proceed to output the final structured JSON."""
