# ==============================================================================
# ОБЩАЯ КОНФИГУРАЦИЯ СЕРВИСОВ SENTIX (.ENV.EXAMPLE)
# ==============================================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=trader
POSTGRES_PASSWORD=strongpassword
POSTGRES_DB=crypto_news
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# --- LLM Service ---
# Вариант 1 (Локальная Ollama):
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=deepseek-r1:14b
# LLM_API_KEY=ollama
#
# Вариант 2 (Groq Cloud Free Tier по токену):
# GROQ_API_KEY=gsk_your_groq_api_key_here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
#
LLM_API_KEY=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_BASE_URL_DOCKER=http://host.docker.internal:11434/v1
LLM_MODEL=deepseek-r1:14b
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=16384
LLM_TIMEOUT=120.0
LLM_MAX_RETRIES=3
MAX_CONTENT_CHARS=4000
MAX_CONCURRENT_REQUESTS=2

# --- Market Evaluator ---
BINANCE_BASE_URL=https://api.binance.com
HTTP_TIMEOUT_SECONDS=15.0
PRE_WINDOW_HOURS=4
POST_WINDOW_HOURS=24
CANDLE_INTERVAL=15m
NEUTRAL_THRESHOLD_PCT=0.2
MIN_NEWS_AGE_HOURS=4.0

# --- Общие параметры воркеров ---
BATCH_SIZE=3
POLL_INTERVAL_SECONDS=10
LOCK_TIMEOUT_MINUTES=15
WORKER_ID=
LOG_LEVEL=INFO
